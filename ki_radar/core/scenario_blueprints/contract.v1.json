    ],
    "use_case.classification": ["business_domain", "capability", "process_area"],
    "origin": ["stage_key", "process_analysis_key", "solution_option_key"]
  },
  "forbidden_objects": [
    "value_stream_focus_decision",
    "process_validation",
    "solution_selection_decision",
    "decision_assessment",
    "approval_decision",
    "governance_assessment",
    "governance_review",
    "delivery_package",
    "delivery_confirmation",
    "handover",
    "pilot",
    "go_live"
  ],
  "repetition": {
    "object_states": ["CREATE", "NO_CHANGE", "CONFLICT"],
    "single_conflict_blocks_complete_apply": true,
    "partial_apply": false,
    "update": false,
    "merge": false,
    "replace": false
  },
  "checksum": {
    "algorithm": "sha256",
    "encoding": "utf-8",
    "sort_object_keys": true,
    "preserve_array_order": true,
    "normalize_decimal_numbers": true,
    "allow_binary_float": false,
    "allow_nan_or_infinity": false
  }
}
