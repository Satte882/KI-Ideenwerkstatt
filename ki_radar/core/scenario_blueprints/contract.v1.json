{
  "format": "ki-radar-scenario-blueprint",
  "schema_version": "1.0",
  "additional_fields_allowed": false,
  "required_top_level": [
    "schema_version",
    "scenario_key",
    "scenario_name",
    "references",
    "value_stream",
    "process_analysis",
    "solution_options",
    "use_case",
    "origin"
  ],
  "cardinality": {
    "value_stream": 1,
    "stages_min": 1,
    "stages_max": 12,
    "process_analysis": 1,
    "solution_options_min": 2,
    "solution_options_max": 8,
    "use_case": 1,
    "origin": 1
  },
  "keys": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "max_length": 100,
    "unique_local_keys": [
      "value_stream.key",
      "value_stream.stages[].key",
      "process_analysis.key",
      "solution_options[].key",
      "use_case.key"
    ],
    "unique_stage_sequence": true
  },
  "references": {
    "business_unit": {
      "lookup": "exact_name",
      "must_exist": true,
      "must_be_unique": true,
      "must_be_active": true
    },
    "users": {
      "lookup": "exact_username",
      "required_roles": [
        "creator",
        "value_stream_owner",
        "business_owner",
        "coordinator",
        "technical_owner"
      ],
      "must_exist": true,
      "must_be_active": true,
      "must_not_be_anonymized": true
    },
    "value_stream_owner": {
      "must_pass": "architecture.forms.is_eligible_value_stream_owner"
    },
    "created_by_blueprint": false
  },
  "allowed_states": {
    "value_stream.status": ["draft"],
    "value_stream.focus.status": ["not_screened"],
    "process_analysis.status": ["draft"],
    "solution_options[].recommendation": ["candidate"],
    "solution_options[].evaluation_status": ["draft"],
    "use_case.status": ["idea"],
    "use_case.decision_status": ["clarification"]
  },
  "allowed_enums": {
    "business_domain": [
      "procurement",
      "sales",
      "marketing",
      "production",
      "logistics",
      "finance",
      "human_resources",
      "customer_service",
      "it",
      "legal_compliance",
      "research_development",
      "corporate_services",
      "other"
    ],
    "solution_option.option_type": [
      "organizational",
      "rule_automation",
      "standard_software",
      "custom_software",
      "analytics_ml",
      "generative_ai",
      "assistant",
      "no_tech",
      "other"
    ],
    "solution_option.feasibility": ["low", "medium", "high"],
    "solution_option.integration_effort": ["low", "medium", "high"],
    "use_case.priority": ["low", "normal", "high", "critical"],
    "use_case.solution_type": [
      "standard",
      "custom",
      "embedded",
      "analytics",
      "generative",
      "assistant",
      "automation",
      "other"
    ],
    "use_case.hosting_type": ["internal", "external", "hybrid", "unknown"],
    "use_case.metric.type": [
      "number",
      "percent",
      "duration",
      "currency",
      "count",
      "rating"
    ],
    "use_case.metric.direction": ["lower", "higher"],
    "level": ["low", "medium", "high"]
  },
  "allowed_fields": {
    "references": ["business_unit", "actors"],
    "references.business_unit": ["name"],
    "references.actors": [
      "creator",
      "value_stream_owner",
      "business_owner",
      "coordinator",
      "technical_owner"
    ],
    "user_reference": ["username"],
    "value_stream": [
      "key",
      "name",
      "status",
      "description",
      "trigger",
      "outcome",
      "scope_in",
      "scope_out",
      "strategic_objective",
      "stakeholders",
      "constraints",
      "focus",
      "stages"
    ],
    "value_stream.focus": ["business_domain", "capability", "status"],
    "value_stream.stage": [
      "key",
      "sequence",
      "name",
      "description",
      "actors",
      "systems",
      "documents",
      "pain_points",
      "baseline_metrics"
    ],
    "process_analysis": [
      "key",
      "stage_key",
      "name",
      "status",
      "scope_start",
      "scope_end",
      "trigger",
      "outcome",
      "current_flow",
      "roles",
      "systems",
      "data_objects",
      "business_rules",
      "handoffs",
      "bottlenecks",
      "exceptions",
      "baseline_metrics",
      "target_state_principles"
    ],
    "solution_option": [
      "key",
      "name",
      "option_type",
      "recommendation",
      "evaluation_status",
      "description",
      "expected_value",
      "bottleneck_coverage",
      "feasibility",
      "data_requirements",
      "application_impact",
      "integration_effort",
      "integration_impact",
      "technology_constraints",
      "risks",
      "architecture_fit"
    ],
    "use_case": [
      "key",
      "title",
      "status",
      "decision_status",
      "summary",
      "problem_statement",
      "affected_process",
      "target_users",
      "priority",
      "solution_type",
      "hosting_type",
      "provider",
      "product_name",
      "model_name",
      "source_systems",
      "data_sources",
      "interface_description",
      "intended_users",
      "intended_purpose",
      "expected_benefit",
      "benefit_category",
      "metric",
      "one_time_cost",
      "recurring_cost",
      "business_value",
      "technical_feasibility",
      "data_readiness",
      "risk_complexity",
      "human_oversight",
      "support_responsibility",
      "classification"
    ],
    "use_case.metric": [
      "name",
      "type",
      "direction",
      "unit",
      "baseline",
      "target",
      "measurement_method"
    ],
    "use_case.classification": ["business_domain", "capability", "process_area"],
    "origin": ["stage_key", "process_analysis_key", "solution_option_key"]
  },
  "required_fields": {
    "references": ["business_unit", "actors"],
    "references.business_unit": ["name"],
    "references.actors": [
      "creator",
      "value_stream_owner",
      "business_owner",
