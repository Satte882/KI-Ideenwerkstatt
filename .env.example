DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=local-development-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ki_radar
POSTGRES_USER=ki_radar
POSTGRES_PASSWORD=ki_radar_local
DJANGO_TIME_ZONE=Europe/Berlin

# Optionaler semantischer Review-Copilot über OpenRouter.
# Ohne API-Key funktionieren alle deterministischen Decision-Checks vollständig.
OPENROUTER_API_KEY=
# Leer lassen, um das in OpenRouter konfigurierte Standardmodell zu verwenden.
OPENROUTER_MODEL=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_APP_NAME=KI-Radar
OPENROUTER_SITE_URL=http://localhost:8000
# Begrenzung der vollständigen Provider-HTTP-Antwort; 1 bis 16 MB.
OPENROUTER_MAX_RESPONSE_BYTES=8000000
# Reasoning bleibt intern aktiv, wird aber nicht in der HTTP-Antwort zurückgeliefert.
OPENROUTER_REASONING_EXCLUDE=true

# Gemeinsame Betriebsgrenzen für Accelerator-LLM-Aufrufe.
# Kompakte LLM-Pfade behalten das gemeinsame Ausgabelimit. Die Capture-Extraktion
# hat wegen des strikten, feldreichen JSON-Schemas ein eigenes hartes Output-Budget.
# Request-Grenzen werden im Capture-/Vorschlagskontext persistent gezählt.
ACCELERATOR_LLM_TIMEOUT_SECONDS=60
ACCELERATOR_LLM_MAX_INPUT_CHARS=12000
# Discovery-Modell; leer verwendet OPENROUTER_MODEL. Investigation bleibt separat.
ACCELERATOR_DISCOVERY_MODEL=google/gemini-3.6-flash
# Discovery-Verifier/Repair benötigen Quellen plus vollständigen strukturierten Draft.
ACCELERATOR_DISCOVERY_MAX_INPUT_CHARS=40000
ACCELERATOR_SOLUTION_CRITIC_MAX_INPUT_CHARS=100000
ACCELERATOR_LLM_MAX_OUTPUT_TOKENS=4096
ACCELERATOR_CAPTURE_MAX_OUTPUT_TOKENS=32768
# Leer: Parameter nicht senden. Optional 0.0 bis 2.0 explizit an den Provider senden.
ACCELERATOR_CAPTURE_TEMPERATURE=
ACCELERATOR_LLM_MAX_CALLS_PER_CONTEXT=3
ACCELERATOR_LLM_MAX_CALLS_PER_USER_DAY=20
ACCELERATOR_LLM_MAX_CALLS_GLOBAL_DAY=100

# Block 7 erzeugt drei Optionen mit je zehn provenance-reichen Feldern in einem Aufruf.
# Dafür gelten bewusst größere, nur für diesen Bundle-Pfad verwendete Grenzen.
ACCELERATOR_SOLUTION_GENERATION_MAX_OUTPUT_TOKENS=16384
ACCELERATOR_SOLUTION_GENERATION_MAX_CALLS_PER_CONTEXT=20

# Feldweise Übernahme nach vollständiger Block-5-Backendintegration.
# Zum sofortigen Abschalten auf false setzen; direkte Requests bleiben serverseitig gesperrt.
ACCELERATOR_FIELD_ADOPTION_ENABLED=true

# Aufbewahrung abgeschlossener Capture Sessions und ihrer Analysen.
# Zulässig sind 30 bis 365 Tage; Standard für die Block-5-Übergangsphase: 90 Tage.
ACCELERATOR_CAPTURE_COMPLETED_RETENTION_DAYS=90

# LLM-Task-Grenzen; bestehende Accelerator-Pfade bleiben separat konfiguriert.
LLM_TASK_TIMEOUT_SECONDS=60
LLM_TASK_TEMPERATURE=0.1
LLM_TASK_MAX_CALLS_PER_CONTEXT_DAY=3
LLM_TASK_MAX_CALLS_PER_USER_DAY=20
LLM_TASK_MAX_CALLS_GLOBAL_DAY=100
# Nur technische Run-Metadaten, keine Prompts, Domain-Texte oder Rohantworten.
LLM_TASK_RUN_RETENTION_DAYS=90

LLM_DELIVERY_FIELD_DRAFT_MAX_INPUT_CHARS=12000
LLM_DELIVERY_FIELD_DRAFT_MAX_OUTPUT_TOKENS=16384
LLM_DELIVERY_FIELD_DRAFT_REASONING_EFFORT=low

# AP2: semantischer Metrik-/Pilotentwurf nach menschlicher AI-Lösungswahl.
# Zahlen für Baseline/Target werden nicht generiert; diese Felder bleiben evidence-only.
LLM_AP2_METRIC_PILOT_MAX_INPUT_CHARS=20000
LLM_AP2_METRIC_PILOT_TIMEOUT_SECONDS=120
LLM_AP2_METRIC_PILOT_MAX_OUTPUT_TOKENS=8192
LLM_AP2_METRIC_PILOT_REASONING_EFFORT=medium

LLM_AP2_ARCHITECTURE_TIMEOUT_SECONDS=120
LLM_AP2_DECISION_GOVERNANCE_TIMEOUT_SECONDS=120

# AP3: section-level Delivery-Synthese + Verify + höchstens ein Repair + Re-Verify.
# User-/Global-Limits bleiben durch die gemeinsamen LLM_TASK-Grenzen wirksam.
LLM_AP3_DELIVERY_MAX_INPUT_CHARS=50000
LLM_AP3_DELIVERY_TIMEOUT_SECONDS=120
LLM_AP3_DELIVERY_MAX_OUTPUT_TOKENS=32768
LLM_AP3_DELIVERY_REASONING_EFFORT=medium
LLM_AP3_DELIVERY_MAX_CALLS_PER_CONTEXT_DAY=4

LLM_ORIGIN_CONSISTENCY_REVIEW_MAX_INPUT_CHARS=16000
LLM_ORIGIN_CONSISTENCY_REVIEW_MAX_OUTPUT_TOKENS=4096
LLM_ORIGIN_CONSISTENCY_REVIEW_REASONING_EFFORT=medium

# Docker-Volume der lokalen PostgreSQL-Datenbank.
# Ohne Angabe nutzt der lokale Stack das projektübliche Volume
# ki-radar-local_local_db und legt es bei Bedarf selbst an.
# Zur Wiederverwendung eines bereits vorhandenen lokalen Volumes (etwa aus einem
# früheren Setup) hier dessen Namen eintragen und LOCAL_DB_VOLUME_EXTERNAL=true
# setzen. Ein externes Volume wird von Docker Compose weder erzeugt noch gelöscht.
# LOCAL_DB_VOLUME=
# LOCAL_DB_VOLUME_EXTERNAL=false
